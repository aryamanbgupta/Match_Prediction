# .gitignore

# Data files
data/raw/*
data/processed/*
data/simulation_results/*
!data/*/README.md
data/
features/
*.parquet

# Model files
*.h5
*.pkl
*.pt
models/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
.env

# Notebooks
.ipynb_checkpoints

# IDE
.vscode/
.idea/

# Database
*.db
*.sqlite3
*.json

# Logs
*.log
logs/

# Autoresearch experiment log
results.tsv

docs/CLOUD_GPU_TESTING.md

# macOS
**/.DS_Store

# Local archive (logs, eval results, legacy scripts kept off main paths).
# Only the data-heavy subdirs are gitignored. README.md, scripts/, and
# notebooks/ inside archive/ ARE tracked so a fresh clone gets the
# explanation + the historical code.
archive/logs/
archive/eval_results/