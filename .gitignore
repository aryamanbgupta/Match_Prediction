# .gitignore

# Data files
data/raw/*
data/processed/*
data/simulation_results/*
!data/*/README.md
data/
features/
*.parquet

# Model files
*.h5
*.pkl
*.pt
models/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
.env

# Notebooks
.ipynb_checkpoints

# IDE
.vscode/
.idea/

# Local Glassbox agent/runtime state
.glassbox/

# Database
*.db
*.sqlite3
*.json

# Logs
*.log
logs/

# Autoresearch verdict log (research/results.tsv) is tracked — it is the
# loop's only cross-run memory.

docs/CLOUD_GPU_TESTING.md

# macOS
**/.DS_Store

# Local archive (logs, eval results, legacy scripts kept off main paths).
# Only the data-heavy subdirs are gitignored. README.md, scripts/, and
# notebooks/ inside archive/ ARE tracked so a fresh clone gets the
# explanation + the historical code.
archive/logs/
archive/eval_results/

# Perf benchmarking scratch space. Only the reusable .py drivers are
# tracked (gated by category rules above + explicit !exception). Run
# logs, intermediate eval JSONs, profiles, and split-symlink dirs stay
# local-only.
perf_runs/*
!perf_runs/*.py
!perf_runs/README.md

# Local scratch space for forward-fixture prediction (refreshed SQLite,
# tracker snapshots, sweep outputs). Never load-bearing for the pipeline.
tmp/

# Eval run outputs: all winner-market eval runs write to eval_out/<tag>/.
# Derived + regenerable; the durable record is the tracked report .md.
# Retired runs move to archive/eval_results/ (ignored above).
eval_out/
models/xgb_match_e4_*/
models/inplay_winprob_v1*/
models/match_winner_map.json
models/prop_fair_baseline_corpus.pkl
data/xgb_match_data_v3_e4_unfrozen/

# autoresearch v2 runtime files
research/night.log
research/STOP

# Orchestrator digest: regenerated from research/IDEAS.md + research/results.tsv
# by research/make_digest.py at the start of every loop iteration. Derived and
# reproducible; the tracked sources are the durable record.
research/digest.md
